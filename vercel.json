{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/guide",
      "destination": "/guide.html"
    },
    {
      "source": "/bots",
      "destination": "https://teamhuman-bots.vercel.app/bots"
    },
    {
      "source": "/bots/:path*",
      "destination": "https://teamhuman-bots.vercel.app/bots/:path*"
    }
  ]
}
